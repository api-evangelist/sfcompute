{
  "opencollection": "1.0.0",
  "info": {
    "name": "SF Compute Account API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List API tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sfcompute.com/v0/tokens"
          },
          "docs": "List API tokens"
        },
        {
          "info": {
            "name": "Create an API token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sfcompute.com/v0/tokens"
          },
          "docs": "Create an API token"
        },
        {
          "info": {
            "name": "Delete an API token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sfcompute.com/v0/tokens/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an API token"
        },
        {
          "info": {
            "name": "Get current account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sfcompute.com/v0/me"
          },
          "docs": "Get current account"
        },
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sfcompute.com/v0/ping"
          },
          "docs": "Health check"
        }
      ]
    }
  ],
  "bundled": true
}