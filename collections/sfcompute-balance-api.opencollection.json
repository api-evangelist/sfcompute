{
  "opencollection": "1.0.0",
  "info": {
    "name": "SF Compute Account Balance API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Balance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sfcompute.com/v0/balance"
          },
          "docs": "Returns available and current account balance in cents."
        },
        {
          "info": {
            "name": "List transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sfcompute.com/v0/transactions"
          },
          "docs": "List transactions"
        }
      ]
    }
  ],
  "bundled": true
}